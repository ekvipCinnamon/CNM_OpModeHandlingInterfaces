| For details check: Apache-2.0_

.. _Apache-2.0: https://www.apache.org/licenses/LICENSE-2.0

.. </legal notes>  

*)

METHOD checkModeIsAllowed : BOOL
VAR_INPUT
	mode :UDINT;
	node :INode;
END_VAR
]]></Declaration>
    </Method>
  </Itf>
</TcPlcObject>