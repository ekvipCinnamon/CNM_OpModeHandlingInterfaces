    <Method Name="getSubnodeName" Id="{255f25d4-9c60-43f7-be3b-9a4fa1280154}">
      <Declaration><![CDATA[(*
## short summary
This method returns the variable name for a subnode at a given array index of the internal array list.
It is required for the HMI connection to construct the node tree from the PLC on HMI side.
It is also intended to be called from the HMI via remote procedure call.

legal notes
=================
| SPDX-FileCopyrightText: © 2024 ekvip automation GmbH <info@ekvip.de>
| SPDX-License-Identifier: Apache-2.0
| For details check: Apache-2.0_

.. _Apache-2.0: https://www.apache.org/licenses/LICENSE-2.0

.. </legal notes>  

*)

METHOD getSubnodeName : CNM_AbstractObject.ObjectName
VAR_INPUT
	(*  index of a subnode in the subnode array list *)
	index :UDINT;
END_VAR
]]></Declaration>
    </Method>
